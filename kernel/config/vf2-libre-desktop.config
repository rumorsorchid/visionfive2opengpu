# Blob-free kernel: no driver that loads non-free firmware is built.
# kernel/blob-audit.sh checks the result after every build. None of this
# hardware exists on the VisionFive 2 (it would only matter for PCIe cards
# and other boards' Ethernet PHYs).
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_R8169 is not set
# CONFIG_REALTEK_PHY is not set
# CONFIG_MICROSEMI_PHY is not set

# Desktop: USB sticks, portals/FUSE, compressed swap in RAM, USB audio
CONFIG_FUSE_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NLS_UTF8=m
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_SND_USB_AUDIO=m
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSI=y
CONFIG_TUN=m

# Game controllers (emulators): joystick API, uinput, hidraw, common pads
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=m
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_INPUT_FF_MEMLESS=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_STEAM=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m

# Root on NVMe without help from the initramfs: the M.2 slot sits behind
# PCIe, whose clocks come from the STG clock controller.
CONFIG_CLK_STARFIVE_JH7110_STG=y
CONFIG_PHY_STARFIVE_JH7110_PCIE=y
CONFIG_PCIE_STARFIVE_HOST=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
