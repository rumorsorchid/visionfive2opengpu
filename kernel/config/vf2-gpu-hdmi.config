# Config fragment for the VisionFive 2 GPU + HDMI stack.
# Apply on top of riscv defconfig:
#   scripts/kconfig/merge_config.sh -m .config vf2-gpu-hdmi.config
#   make ARCH=riscv olddefconfig

# --- Cache coherency -------------------------------------------------------
# The GPU and display controller are not snooped by the U74 L2. The U74
# lacks Svpbmt, so without XPbmtUC "write-combined"/uncached CPU mappings of
# GPU buffers are silently cacheable and the CPU reads stale firmware
# completion data (symptom: job timeouts and FW hard resets).
CONFIG_ERRATA_SIFIVE=y
CONFIG_ERRATA_SIFIVE_XPBMTUC=y
CONFIG_RISCV_DMA_NONCOHERENT=y
CONFIG_SIFIVE_CCACHE=y
# Streaming DMA (buffers shared with the GPU and the display controller)
# needs L2 flushes: sifive_ccache registers its flush ops for
# "starfive,jh7110-ccache" only with RISCV_NONSTANDARD_CACHE_OPS. That
# symbol has no prompt; ERRATA_THEAD_CMO (riscv defconfig) selects it. The
# second line makes build.sh fail if it ever goes missing.
CONFIG_ERRATA_THEAD_CMO=y
CONFIG_RISCV_NONSTANDARD_CACHE_OPS=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# --- Power / clocks ----------------------------------------------------------
CONFIG_JH71XX_PMU=y
CONFIG_CLK_STARFIVE_JH7110_SYS=y
CONFIG_CLK_STARFIVE_JH7110_AON=y
CONFIG_CLK_STARFIVE_JH7110_VOUT=y

# --- Display: DC8200 + Innosilicon HDMI --------------------------------------
# Built in, as in the community bring-up's tested configuration: the
# console comes up on HDMI early in boot, independent of the initramfs, and
# the drivers claim their clocks before unused clocks are switched off.
CONFIG_DRM=y
CONFIG_DRM_VERISILICON_DC=y
CONFIG_DRM_STARFIVE_JH7110_INNO_HDMI=y
CONFIG_PHY_STARFIVE_JH7110_INNO_HDMI=y
CONFIG_SOC_STARFIVE_JH7110_VOUT_SUBSYSTEM=y
CONFIG_SOC_STARFIVE_JH7110_HDMI_SUBSYSTEM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Boot console on the framebuffer U-Boot hands over through the EFI GOP
# (jh7110_hdmi, EFI boot path); verisilicon-dc replaces it when it loads.
CONFIG_DRM_EFIDRM=y

# --- GPU: Imagination BXE-4-32 -----------------------------------------------
CONFIG_DRM_POWERVR=m
CONFIG_DEBUG_FS=y

# --- Userspace conveniences --------------------------------------------------
CONFIG_INPUT_EVDEV=y
CONFIG_SND_SOC=m
