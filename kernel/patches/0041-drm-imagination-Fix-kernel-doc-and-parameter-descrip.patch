From de3e0e2442f55211b3fd7cc50446a5929d2d665c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 17:29:26 +0000
Subject: [PATCH 41/41] drm/imagination: Fix kernel-doc and parameter
 description for heap guards

PVR_VM_NUM_HEAP_GUARDS was defined between the kernel-doc comment of
struct pvr_vm_context and the struct itself, which detaches the comment
("Cannot parse struct or union!" with W=1). Move the define above it, and
add the missing MODULE_PARM_DESC for kernel_heap_guards.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015xcU1TUoi3P8rtmwjuUPqK
---
 drivers/gpu/drm/imagination/pvr_job.c | 2 ++
 drivers/gpu/drm/imagination/pvr_vm.c  | 4 ++--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/imagination/pvr_job.c b/drivers/gpu/drm/imagination/pvr_job.c
index a7f53a2beb..524abe3525 100644
--- a/drivers/gpu/drm/imagination/pvr_job.c
+++ b/drivers/gpu/drm/imagination/pvr_job.c
@@ -30,6 +30,8 @@
 
 static unsigned int kernel_heap_guards = 1;
 module_param(kernel_heap_guards, uint, 0644);
+MODULE_PARM_DESC(kernel_heap_guards,
+		 "Map a guard BO above the PDS/USC heap high-water marks on each submit (default: 1)");
 
 static unsigned long kernel_heap_guard_size = 0x800000;
 module_param(kernel_heap_guard_size, ulong, 0644);
diff --git a/drivers/gpu/drm/imagination/pvr_vm.c b/drivers/gpu/drm/imagination/pvr_vm.c
index 6dc2fa666f..4bdf3f508d 100644
--- a/drivers/gpu/drm/imagination/pvr_vm.c
+++ b/drivers/gpu/drm/imagination/pvr_vm.c
@@ -31,11 +31,11 @@
  * API as an opaque handle.
  */
 
+#define PVR_VM_NUM_HEAP_GUARDS 2
+
 /**
  * struct pvr_vm_context - Context type used to represent a single VM.
  */
-#define PVR_VM_NUM_HEAP_GUARDS 2
-
 struct pvr_vm_context {
 	/**
 	 * @pvr_dev: The PowerVR device to which this context is bound.
